# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
sdd_orchestrator-*.tar

# Dialyzer PLT files (rebuilt from the locked dependency set).
/priv/plts/

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# `mix phx.digest` byproducts written into priv/static (regenerated on release):
# fingerprinted copies (name-<md5>.ext) and their gzip variants.
/priv/static/**/*.gz
/priv/static/**/*-????????????????????????????????.*

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Playwright end-to-end test artifacts.
/assets/test-results/
/assets/playwright-report/
/assets/blob-report/
/assets/.playwright/
/assets/playwright/.cache/

# Local source archives for exported design references.
/SDD Orchestrator onboarding prototype.zip

# macOS metadata.
.DS_Store

# Local environment secrets (e.g. GitHub App credentials for `mix phx.server`).
# Loaded by config/dev.exs; never committed.
.env
.env.*
