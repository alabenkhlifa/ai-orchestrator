#!/bin/sh
# specs/36-local-worker-native-distribution Task 1.
#
# Scoped to the `:worker` release only (see `:rel_templates_path` in
# `mix.exs`'s `releases/0`). Sourced by the generated `bin/worker` before
# the VM boots, so `SddOrchestrator.Application.start/2` and
# `config/runtime.exs` can both gate on this without the operator having
# to set it manually.
export SDD_ORCHESTRATOR_RELEASE_MODE=worker
