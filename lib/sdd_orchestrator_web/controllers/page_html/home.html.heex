<Layouts.flash_group flash={@flash} />
<.app_shell max_width="max-w-xl">
  <div class="flex flex-col items-center text-center py-10">
    <span class="w-14 h-14 rounded-xl bg-primary text-on-primary flex items-center justify-center">
      <.lucide name="logo" class="size-7" />
    </span>
    <h1 class="mt-5 text-2xl font-bold tracking-tight text-ink">SDD Orchestrator</h1>
    <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-muted">
      Spec-driven, AI-assisted development. This build establishes the shared
      presentation foundation; the onboarding entry surface arrives with the
      authentication workflow.
    </p>
  </div>
</.app_shell>
