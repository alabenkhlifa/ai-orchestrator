<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="SDD Orchestrator">{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Device-local theme, applied before first paint. The choice lives only in
          this device's localStorage; it is never sent to the server, an identity,
          or another device. With no explicit choice the OS preference is used.
          The nonce lets this single inline script run under the strict CSP. --%>
    <script nonce={assigns[:csp_nonce]}>
      (() => {
        const KEY = "sdd:theme";
        const mm = window.matchMedia("(prefers-color-scheme: dark)");
        const systemTheme = () => (mm.matches ? "dark" : "light");
        const apply = (theme, source) => {
          const root = document.documentElement;
          root.setAttribute("data-theme", theme);
          root.setAttribute("data-theme-source", source);
        };
        const stored = localStorage.getItem(KEY);
        if (stored === "light" || stored === "dark") {
          apply(stored, "user");
        } else {
          apply(systemTheme(), "system");
        }
        // Follow OS changes only while no explicit device choice exists.
        mm.addEventListener("change", () => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            apply(systemTheme(), "system");
          }
        });
        // Keep tabs on the same device in sync with an explicit choice.
        window.addEventListener("storage", (e) => {
          if (e.key !== KEY) return;
          const v = e.newValue;
          v === "light" || v === "dark" ? apply(v, "user") : apply(systemTheme(), "system");
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
