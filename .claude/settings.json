      "Bash(mix compile:*)",
      "Bash(mix check:*)",
      "Bash(mix credo:*)",
      "Bash(mix dialyzer:*)",
      "Bash(mix deps.audit:*)",
      "Bash(mix deps.get:*)",
      "Bash(mix sobelow:*)",
      "Bash(mix setup:*)",
      "Bash(mix ecto.create:*)",
      "Bash(mix ecto.migrate:*)",
      "Bash(MIX_ENV=* mix test*)",
      "Bash(MIX_ENV=* mix format*)",
      "Bash(MIX_ENV=* mix compile*)",
      "Bash(MIX_ENV=* mix check*)",
      "Bash(MIX_ENV=* mix credo*)",
      "Bash(MIX_ENV=* mix dialyzer*)",
      "Bash(MIX_ENV=* mix ecto.create*)",
      "Bash(MIX_ENV=* mix ecto.migrate*)",
